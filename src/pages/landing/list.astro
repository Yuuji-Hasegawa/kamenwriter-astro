---
import Layout from "@/layouts/Layout.astro"
import { Picture } from "astro:assets"
import img01 from "@/images/thumb.png"
import img02 from "@/images/thumb-shin.png"
import img03 from "@/images/thumb-yebisuan.png"
import img04 from "@/images/thumb-art.png"
import img05 from "@/images/thumb-bbns.png"
import img06 from "@/images/thumb-bbnslp.png"
import profile from "@/images/profile_img.jpg"
---

<Layout title="リンク一覧" pageType="noindex">
  <div class="o-center u-insert-center u-space-clamp">
    <h1 class="c-heading u-txt-thn">リンク一覧</h1>
    <p class="c-qua-heading u-txt-thn">名刺に掲載しきれなかった関連情報です。</p>
    <h2 class="c-sec-heading u-txt-thn u-fnt-en">Website</h2>
    <ul class="o-grid :half">
      <li>
        <a
          class="o-stack u-insert-stack u-space-none c-card-link"
          href="https://www.kamenwriter.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="c-display-2xs u-fnt-en u-txt-thn">HP</span><br />
          <span class="c-content-l c-card-link__inner u-fnt-en u-txt-thn u-mb-m">https://www.kamenwriter.com</span>
          <Picture
            pictureAttributes={{ class: "o-frame js-cnt-v-auto" }}
            src={img01}
            width={img01.width / 2}
            height={img01.height / 2}
            widths={[240, 480, 540, 720, 1024, 1440, img01.width / 2]}
            sizes={`(max-width: 360px) 240px, (max-width: 520px) 480px, (max-width: 720px) 540px, (max-width: 960px) 768px, (max-width: 1280px) 1024px, (max-width: 1536px) 1440px, ${img01.width / 2}px`}
            formats={["avif", "webp"]}
            fetchpriority="low"
            alt=""
          />
        </a>
      </li>
      <li>
        <a
          class="o-stack u-insert-stack u-space-none c-card-link"
          href="https://www.shin-kamenwriter.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="c-display-2xs">ポートフォリオ</span><br />
          <span class="c-content-l c-card-link__inner u-fnt-en u-txt-thn u-mb-m">https://www.shin-kamenwriter.com</span>
          <Picture
            pictureAttributes={{ class: "o-frame js-cnt-v-auto" }}
            src={img02}
            width={img02.width / 2}
            height={img02.height / 2}
            widths={[240, 480, 540, 720, 1024, 1440, img02.width / 2]}
            sizes={`(max-width: 360px) 240px, (max-width: 520px) 480px, (max-width: 720px) 540px, (max-width: 960px) 768px, (max-width: 1280px) 1024px, (max-width: 1536px) 1440px, ${img02.width / 2}px`}
            formats={["avif", "webp"]}
            fetchpriority="low"
            alt=""
          />
        </a>
      </li>
      <li>
        <a
          class="o-stack u-insert-stack u-space-none c-card-link"
          href="https://yebisuan.jp/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="c-display-2xs">ポートフォリオ未掲載事例 1</span><br />
          <span class="c-content-l c-card-link__inner u-fnt-en u-txt-thn u-mb-m">https://yebisuan.jp/</span>
          <Picture
            pictureAttributes={{ class: "o-frame js-cnt-v-auto" }}
            src={img03}
            width={img03.width / 2}
            height={img03.height / 2}
            widths={[240, 480, 540, 720, 1024, 1440, img03.width / 2]}
