            formats={["avif", "webp"]}
            fetchpriority="low"
            alt=""
          />
        </a>
      </li>
      <li>
        <a
          class="o-stack u-insert-stack u-space-none c-card-link"
          href="https://artsalonmikage.jp/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="c-display-2xs">ポートフォリオ未掲載事例 2</span><br />
          <span class="c-content-l c-card-link__inner u-fnt-en u-txt-thn u-mb-m">https://artsalonmikage.jp/</span>
          <Picture
            pictureAttributes={{ class: "o-frame js-cnt-v-auto" }}
            src={img04}
            width={img04.width / 2}
            height={img04.height / 2}
            widths={[240, 480, 540, 720, 1024, 1440, img04.width / 2]}
