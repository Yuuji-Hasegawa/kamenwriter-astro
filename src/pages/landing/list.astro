            alt=""
          />
        </a>
      </li>
    </ul>
    <h2 class="c-sec-heading u-txt-thn u-fnt-en">Profile / SNS</h2>
    <div class="o-sidebar">
      <div class="c-bio-pict u-mx-auto">
        <Picture
          pictureAttributes={{ class: "o-frame :sq :r js-cnt-v-auto" }}
          src={profile}
          formats={["avif", "webp"]}
          fetchpriority="low"
          alt=""
        />
      </div>
      <div class="o-stack c-bio-txt u-mx-auto">
        <p class="c-display-xs u-mx-auto u-dsp-tbl">長谷川 雄治（仮面ライター）</p>
        <p class="c-content-l u-mx-auto u-mb-s u-dsp-tbl">Yuji Hasegawa (KamenWriter)</p>
        <div class="c-content-m u-mb-m">
          <span class="u-dsp-blc u-mb-m">
            昭和63年生まれ。大阪電気通信大学 総合情報学部 デジタルゲーム学科卒。<br />
            2011年からWeb制作に従事。コーディングやWordPressのカスタマイズ等を主に経験を積む。<br />
            2013年、仮面ライターとして独立開業。<br />
            マーケティングや企画、上流も下流も幅広く対応。<br />
            コーディングとコンテンツ制作の同時提供を考えるヘンな人。
          </span>
          <span class="u-dsp-blc">
            ■ HTML:Living Standard 4.11.1<br />
            ■ CSS:Snapshot 2023<br />
            ■ Javascript:Vanilla ES6<br />
            ■ WordPress:6.9~<br />
            ■ ビルドツール:bun + Vite<br />
            ■ CSS設計:Every Layout + カスタムプロパティ + ユーティリティファースト<br />
            ■ デザインツール:Figma<br />
            ■ 開発環境:MacBook Air (M1, 2020)<br />
            ■ MBTI:INFJ<br />
            ■ 主な強み:戦略性、内省、学習欲、収集心、個別化
          </span>
        </div>
